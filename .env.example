# Secret key for signing JWT auth tokens (keep secret!)
JWT_SECRET=b8d7f3e2a1c9054817a9e5df2b6c0391e84a27bc1d4e680a91f5e27a69b0d1e3
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database Connection (SQLite local file)
DATABASE_URL=sqlite:///./backend/stock_sim.db

# Virtual Wallet & Trading Defaults
STARTING_CASH_PAISE=100000000
MIS_MARGIN_PERCENT=20
FLAT_FEE_PAISE=0

# Scheduled Engine Intervals (seconds)
PRICE_REFRESH_SECONDS=60
ORDER_ENGINE_SECONDS=60

# Indian Market Hours (IST - Asia/Kolkata)
MARKET_OPEN=09:15
MARKET_CLOSE=15:30
MIS_SQUARE_OFF_TIME=15:15
MIS_CUTOFF_NEW_ORDERS=15:15

# Replay Mode (set true to simulate live market trading anytime, even when NSE is closed)
REPLAY_MODE=false
REPLAY_SPEED_SECONDS=2

# CORS origins (for development)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
